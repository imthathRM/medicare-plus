# MediCare Plus Backend Environment Configuration Example
# Copy this file to .env and configure values for your environment.

# Server Port
PORT=5000

# Runtime Environment (development | production | test)
NODE_ENV=development

# Allowed CORS Origin for Frontend
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma ORM)
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/MediCare_Plus?schema=public"

# JWT Authentication (Stage 7)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h
