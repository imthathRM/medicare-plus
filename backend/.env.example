# MediCare Plus Backend Environment Configuration Example
# Copy this file to .env and configure values for your environment.

# Server Port
PORT=5000

# Runtime Environment (development | production | test)
NODE_ENV=development

# Allowed CORS Origin for Frontend
CORS_ORIGIN=http://localhost:5173

# Future MongoDB URI (Scheduled for Stage 6 - currently ignored)
# MONGODB_URI=mongodb://localhost:27017/medicare_plus

# Future JWT Secret (Scheduled for Stage 7 - currently ignored)
# JWT_SECRET=your_jwt_secret_key_here
