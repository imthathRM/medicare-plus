{
  "name": "medicare-plus-backend",
  "version": "1.0.0",
  "description": "MediCare Plus Hospital Management System - Express Backend (Stage 5)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test-backend.js",
    "test:integration": "node test-stage8-integration.js",
    "test:all": "node test-backend.js && node test-stage8-integration.js",
    "test:health": "node -e \"fetch('http://localhost:5000/api/health').then(r=>r.json()).then(console.log)\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  }
}
